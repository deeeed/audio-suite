{
    "extends": "expo-module-scripts/tsconfig.plugin",
    "compilerOptions": {
        "outDir": "build",
        "lib": ["es2023", "dom"],
        "rootDir": "src",
        "types": ["node"]
    },
    "ts-node": {
        "compilerOptions": {
            "rootDir": "."
        }
    },
    "include": ["./src"],
    "exclude": [
        "**/__mocks__/*",
        "**/__tests__/*",
        "**/*.test.ts",
        "**/*.spec.ts"
    ]
}
