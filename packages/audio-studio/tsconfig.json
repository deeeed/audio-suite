{
    "extends": "expo-module-scripts/tsconfig.base",
    "compilerOptions": {
        "rootDir": "./src",
        "ignoreDeprecations": "6.0",
        "verbatimModuleSyntax": false,
        "noUncheckedIndexedAccess": false,
        "types": ["jest", "node"],
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "typeRoots": [
            "./node_modules/@types",
            "../../node_modules/@types",
        ]
    },
    "ts-node": {
        "compilerOptions": {
            "rootDir": "."
        }
    },
    "include": ["./src"],
    "exclude": ["**/__mocks__/*", "**/__tests__/*"]
}
