+++ b/wasm/combined/sherpa-onnx-wasm-main-combined.cc
@@ -0,0 +1,24 @@
+// wasm/combined/sherpa-onnx-wasm-main-combined.cc
+//
+// Wrapper-carried combined wasm entry point. Exports all C-API symbols
+// across ASR, TTS, VAD, KWS, speech enhancement, and speaker diarization
+// in a single .wasm bundle so consumers don't need to load N feature
+// modules separately. C-API symbols come from libsherpa-onnx-c-api.a;
+// only CopyHeap is provided locally.
+
+#include <stdio.h>
+
+#include <algorithm>
+#include <cstdint>
+
+#include "sherpa-onnx/c-api/c-api.h"
+
+extern "C" {
+
+void CopyHeap(const char *src, int32_t num_bytes, char *dst) {
+  std::copy(src, src + num_bytes, dst);
+}
+
+void MyPrint(const char *p) { fprintf(stderr, "%s\n", p); }
+
+}
