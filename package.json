        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native@npm:0.86.2": "patch:react-native@npm%3A0.86.2#~/.yarn/patches/react-native-npm-0.86.2-c9d546616f.patch"
    },
    "devDependencies": {
        "@expo/config-plugins": "~57.0.8",
        "@storybook/react-native-web-vite": "^10.2.10",
        "eslint-import-resolver-typescript": "^3.7.0",
        "eslint-plugin-import": "^2.31.0",
        "globals": "^15.8.0",
        "lefthook": "^1.7.2",
        "null-loader": "^4.0.1",
        "pngjs": "^7.0.0",
        "prettier": "^3.3.3",
        "storybook": "^10.2.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.60.0",
        "vite": "^6.3.5",
        "ws": "^8.19.0"
    },
    "packageManager": "yarn@4.9.1"
