{
  "name": "essentia-demo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "EXPO_USE_METRO_WORKSPACE_ROOT=1 NODE_ENV=development expo start --dev-client --port 7249",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android --port 7249",
    "ios": "expo run:ios --device --port 7249",
    "web": "expo start --web --port 7249",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "deploy": "NODE_ENV=production expo export -p web && gh-pages -t -d dist --dest essentia-demo"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@siteed/audio-studio": "workspace:^",
    "@siteed/react-native-essentia": "workspace:^",
    "expo": "^57.0.14",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.12",
    "expo-constants": "~57.0.12",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19",
    "gh-pages": "^6.2.0",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "../../packages/",
      "exclude": [
        "@siteed/moonshine.rn",
        "@siteed/sherpa-onnx.rn"
      ]
    }
  }
}
