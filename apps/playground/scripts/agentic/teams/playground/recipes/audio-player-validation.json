{
  "title": "Audio Player Widget validation",
  "description": "Drives the audio-player demo screen end-to-end via __AGENTIC__.audioPlayer probes. Verifies progressive preview streaming, silence threshold plumbing, transport (play / pause), seek-by-tap, and AudioExtractionError mapping.",
  "validate": {
    "workflow": {
      "entry": "nav-audio-player",
      "pre_conditions": [
        "playground.agentic_ready"
      ],
      "nodes": {
        "nav-audio-player": {
          "action": "navigate",
          "target": "/audio-player",
          "next": "wait-route"
        },
        "wait-route": {
          "action": "wait_for",
          "route": "/audio-player",
          "timeout_ms": 10000,
          "next": "wait-mounted"
        },
        "wait-mounted": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.audioPlayer?.getState() || null)",
          "assert": {
            "operator": "eq",
            "field": "mounted",
            "value": true
          },
          "timeout_ms": 10000,
          "poll_ms": 200,
          "next": "load-sample"
        },
        "load-sample": {
          "action": "eval_ref",
          "ref": "audio-player-load-sample",
          "assert": { "operator": "eq", "field": "ok", "value": true },
          "next": "wait-streaming-mid"
        },
        "wait-streaming-mid": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.audioPlayer?.getState() || null)",
          "assert": {
            "operator": "gt",
            "field": "pointsReceived",
            "value": 0
          },
          "fail_when": {
            "operator": "not_null",
            "field": "lastError"
          },
          "timeout_ms": 30000,
          "poll_ms": 50,
          "next": "wait-streaming-complete"
        },
        "wait-streaming-complete": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.audioPlayer?.getState() || null)",
          "assert": {
            "all": [
              { "operator": "eq", "field": "isStreaming", "value": false },
              { "operator": "gte", "field": "totalPoints", "value": 50 },
              { "operator": "gt", "field": "durationMs", "value": 1000 }
            ]
          },
          "fail_when": {
            "operator": "not_null",
            "field": "lastError"
          },
          "timeout_ms": 30000,
          "poll_ms": 200,
          "next": "transport-switch"
        },
        "transport-switch": {
          "action": "switch",
          "cases": [
            {
              "label": "web-matrix",
              "when": {
                "operator": "eq",
                "field": "env.platform",
                "value": "web"
              },
              "next": "set-threshold-high"
            },
            {
              "label": "web-direct",
              "when": {
                "operator": "contains",
                "field": "env.device",
                "value": "web"
              },
              "next": "set-threshold-high"
            }
          ],
          "default": "play-audio"
        },
        "play-audio": {
          "action": "eval_ref",
          "ref": "audio-player-play",
          "assert": { "operator": "eq", "field": "ok", "value": true },
          "next": "wait-playing"
        },
        "wait-playing": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.audioPlayer?.getState() || null)",
          "assert": {
            "all": [
              { "operator": "eq", "field": "isPlaying", "value": true },
              { "operator": "gt", "field": "currentTimeMs", "value": 0 }
            ]
          },
          "timeout_ms": 5000,
          "poll_ms": 100,
          "next": "pause-after-play"
        },
        "pause-after-play": {
          "action": "eval_ref",
          "ref": "audio-player-pause",
          "assert": { "operator": "eq", "field": "ok", "value": true },
          "next": "wait-paused-after-play"
        },
        "wait-paused-after-play": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.audioPlayer?.getState() || null)",
          "assert": {
            "operator": "eq",
            "field": "isPlaying",
            "value": false
          },
          "timeout_ms": 5000,
          "poll_ms": 100,
          "next": "seek-half"
        },
        "seek-half": {
          "action": "eval_ref",
          "ref": "audio-player-seek-half",
          "assert": { "operator": "eq", "field": "ok", "value": true },
          "next": "wait-seeked"
        },
        "wait-seeked": {
          "action": "wait_for",
          "expression": "(function(){ var s = globalThis.__AGENTIC__ && globalThis.__AGENTIC__.audioPlayer ? globalThis.__AGENTIC__.audioPlayer.getState() : null; if (!s) return JSON.stringify({ ok: false }); return JSON.stringify({ currentRatio: s.durationMs > 0 ? s.currentTimeMs / s.durationMs : 0 }); })()",
          "assert": {
            "operator": "gte",
            "field": "currentRatio",
            "value": 0.4
          },
          "timeout_ms": 5000,
          "poll_ms": 100,
          "next": "set-threshold-high"
        },
        "set-threshold-high": {
          "action": "eval_ref",
          "ref": "audio-player-set-threshold-high",
          "assert": { "operator": "eq", "field": "ok", "value": true },
          "next": "wait-threshold-applied"
        },
        "wait-threshold-applied": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.audioPlayer?.getState() || null)",
          "assert": {
            "all": [
              { "operator": "eq", "field": "isStreaming", "value": false },
              { "operator": "eq", "field": "threshold", "value": 0.5 },
              { "operator": "gt", "field": "silentSegmentCount", "value": 0 }
            ]
          },
          "fail_when": {
            "operator": "not_null",
            "field": "lastError"
          },
          "timeout_ms": 30000,
          "poll_ms": 200,
          "next": "toggle-silence-off"
        },
        "toggle-silence-off": {
          "action": "eval_ref",
          "ref": "audio-player-toggle-silence-off",
          "assert": { "operator": "eq", "field": "ok", "value": true },
          "next": "wait-silence-off"
        },
        "wait-silence-off": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.audioPlayer?.getState() || null)",
          "assert": {
            "operator": "eq",
            "field": "showSilenceTrack",
            "value": false
          },
          "timeout_ms": 3000,
          "poll_ms": 100,
          "next": "toggle-silence-on"
        },
        "toggle-silence-on": {
          "action": "eval_ref",
          "ref": "audio-player-toggle-silence-on",
          "assert": { "operator": "eq", "field": "ok", "value": true },
          "next": "wait-silence-on"
        },
        "wait-silence-on": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.audioPlayer?.getState() || null)",
          "assert": {
            "operator": "eq",
            "field": "showSilenceTrack",
            "value": true
          },
          "timeout_ms": 3000,
          "poll_ms": 100,
          "next": "load-bogus"
        },
        "load-bogus": {
          "action": "eval_ref",
          "ref": "audio-player-load-bogus",
          "assert": { "operator": "eq", "field": "ok", "value": true },
          "next": "wait-error-mapped"
        },
        "wait-error-mapped": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.audioPlayer?.getState() || null)",
          "assert": {
            "all": [
              { "operator": "not_null", "field": "lastError" },
              { "operator": "not_null", "field": "lastError.code" }
            ]
          },
          "timeout_ms": 30000,
          "poll_ms": 200,
          "next": "reload-sample"
        },
        "reload-sample": {
          "action": "eval_ref",
          "ref": "audio-player-load-sample",
          "assert": { "operator": "eq", "field": "ok", "value": true },
          "next": "wait-recovered"
        },
        "wait-recovered": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.audioPlayer?.getState() || null)",
          "assert": {
            "all": [
              { "operator": "eq", "field": "isStreaming", "value": false },
              { "operator": "gte", "field": "totalPoints", "value": 50 },
              { "operator": "eq", "field": "lastError", "value": null }
            ]
          },
          "timeout_ms": 30000,
          "poll_ms": 200,
          "next": "done"
        },
        "done": {
          "action": "end",
          "status": "pass"
        }
      }
    }
  }
}
