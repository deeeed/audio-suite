{
  "title": "Record tab Moonshine + Sherpa live validation",
  "description": "Enables the main Record tab advanced Moonshine + Sherpa live mode, starts recording, and verifies Moonshine transcript events, Sherpa speaker-turn events, attributed transcript rendering, and clean stop state.",
  "validate": {
    "workflow": {
      "entry": "nav-record",
      "pre_conditions": [
        "playground.agentic_ready"
      ],
      "nodes": {
        "nav-record": {
          "action": "navigate",
          "target": "/record",
          "next": "wait-record-route"
        },
        "wait-record-route": {
          "action": "wait_for",
          "route": "/record",
          "next": "read-record-ui-state"
        },
        "read-record-ui-state": {
          "action": "eval_ref",
          "ref": "record-page-state",
          "save_as": "recordStateBeforeEnable",
          "next": "choose-enable-mode",
          "assert": {
            "operator": "eq",
            "field": "route",
            "value": "/record"
          }
        },
        "choose-enable-mode": {
          "action": "switch",
          "description": "Skip the Moonshine + Sherpa toggle when it is already enabled; otherwise reveal advanced settings only if needed.",
          "cases": [
            {
              "label": "already-enabled",
              "when": {
                "operator": "eq",
                "field": "last.enableMoonshineSherpaLive",
                "value": true
              },
              "next": "choose-result-state"
            },
            {
              "label": "advanced-visible",
              "when": {
                "operator": "eq",
                "field": "last.advancedMode",
                "value": true
              },
              "next": "wait-moonshine-sherpa-toggle"
            }
          ],
          "default": "show-advanced"
        },
        "show-advanced": {
          "action": "press",
          "test_id": "record-show-advanced-settings",
          "next": "wait-moonshine-sherpa-toggle"
        },
        "wait-moonshine-sherpa-toggle": {
          "action": "wait_for",
          "test_id": "record-enable-moonshine-sherpa-live",
          "next": "enable-moonshine-sherpa"
        },
        "enable-moonshine-sherpa": {
          "action": "press",
          "test_id": "record-enable-moonshine-sherpa-live",
          "next": "wait-enabled"
        },
        "wait-enabled": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "operator": "eq",
            "field": "enableMoonshineSherpaLive",
            "value": true
          },
          "timeout_ms": 30000,
          "poll_ms": 1000,
          "next": "choose-result-state"
        },
        "choose-result-state": {
          "action": "switch",
          "description": "Clear any previous recording result before pressing the start button.",
          "cases": [
            {
              "label": "recording-result-visible",
              "when": {
                "operator": "eq",
                "field": "last.hasRecordingResult",
                "value": true
              },
              "next": "press-record-again"
            }
          ],
          "default": "press-start"
        },
        "press-record-again": {
          "action": "press",
          "test_id": "record-again-button",
          "next": "post-record-again-settle"
        },
        "post-record-again-settle": {
          "action": "wait",
          "ms": 1000,
          "next": "press-start"
        },
        "press-start": {
          "action": "press",
          "test_id": "start-recording-button",
          "next": "wait-recording"
        },
        "wait-recording": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "all": [
              {
                "operator": "eq",
                "field": "isMoonshineSherpaRecording",
                "value": true
              },
              {
                "operator": "eq",
                "field": "moonshineSherpaSherpaReady",
                "value": true
              }
            ]
          },
          "fail_when": {
            "operator": "not_null",
            "field": "moonshineSherpaError"
          },
          "timeout_ms": 180000,
          "poll_ms": 1000,
          "next": "wait-output-visible"
        },
        "wait-output-visible": {
          "action": "wait_for",
          "test_id": "record-moonshine-sherpa-live-output",
          "next": "wait-chunk-fanout"
        },
        "wait-chunk-fanout": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "all": [
              {
                "operator": "gte",
                "field": "moonshineSherpaMoonshineStats.chunks",
                "value": 3
              },
              {
                "operator": "gte",
                "field": "moonshineSherpaSherpaStats.chunks",
                "value": 3
              }
            ]
          },
          "fail_when": {
            "operator": "not_null",
            "field": "moonshineSherpaError"
          },
          "timeout_ms": 90000,
          "poll_ms": 1000,
          "next": "wait-transcript"
        },
        "wait-transcript": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "any": [
              {
                "operator": "gte",
                "field": "moonshineSherpaLiveInterimLineCount",
                "value": 1
              },
              {
                "operator": "gte",
                "field": "moonshineSherpaLiveCommittedLineCount",
                "value": 1
              }
            ]
          },
          "fail_when": {
            "operator": "not_null",
            "field": "moonshineSherpaError"
          },
          "timeout_ms": 180000,
          "poll_ms": 1000,
          "next": "wait-sherpa-event"
        },
        "wait-sherpa-event": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "any": [
              {
                "operator": "gte",
                "field": "moonshineSherpaSpeakerEventCounts.speech_start",
                "value": 1
              },
              {
                "operator": "gte",
                "field": "moonshineSherpaFinalTurnCount",
                "value": 1
              },
              {
                "operator": "gte",
                "field": "moonshineSherpaTurnCount",
                "value": 1
              }
            ]
          },
          "fail_when": {
            "operator": "not_null",
            "field": "moonshineSherpaError"
          },
          "timeout_ms": 180000,
          "poll_ms": 1000,
          "next": "wait-controlled-speech-window"
        },
        "wait-controlled-speech-window": {
          "action": "wait",
          "ms": 50000,
          "next": "assert-still-healthy-before-stop"
        },
        "assert-still-healthy-before-stop": {
          "action": "eval_ref",
          "ref": "record-page-state",
          "assert": {
            "operator": "eq",
            "field": "moonshineSherpaError",
            "value": null
          },
          "next": "press-stop"
        },
        "press-stop": {
          "action": "press",
          "test_id": "stop-recording-button",
          "next": "wait-final-attributed"
        },
        "wait-final-attributed": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "any": [
              {
                "operator": "gte",
                "field": "moonshineSherpaAttributedCommittedLineCount",
                "value": 1
              },
              {
                "operator": "gte",
                "field": "moonshineSherpaAttributedInterimLineCount",
                "value": 1
              }
            ]
          },
          "fail_when": {
            "operator": "not_null",
            "field": "moonshineSherpaError"
          },
          "timeout_ms": 120000,
          "poll_ms": 1000,
          "next": "wait-stopped"
        },
        "wait-stopped": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "operator": "eq",
            "field": "isMoonshineSherpaRecording",
            "value": false
          },
          "fail_when": {
            "operator": "not_null",
            "field": "moonshineSherpaError"
          },
          "timeout_ms": 60000,
          "poll_ms": 1000,
          "next": "wait-result-output-visible"
        },
        "wait-result-output-visible": {
          "action": "wait_for",
          "test_id": "record-moonshine-sherpa-result-output",
          "timeout_ms": 30000,
          "poll_ms": 1000,
          "next": "post-stop-settle"
        },
        "post-stop-settle": {
          "action": "wait",
          "ms": 3000,
          "next": "assert-no-late-error"
        },
        "assert-no-late-error": {
          "action": "eval_ref",
          "ref": "record-page-state",
          "assert": {
            "operator": "eq",
            "field": "moonshineSherpaError",
            "value": null
          },
          "next": "done"
        },
        "done": {
          "action": "end",
          "status": "pass"
        }
      }
    }
  }
}
