{
  "title": "Playground Moonshine + Sherpa live validation",
  "description": "Opens the dev-only Moonshine live screen, prepares the selected Moonshine model, starts live recording, and asserts the same 16 kHz audio chunks are processed by both Moonshine.rn and Sherpa ONNX speaker-turn plumbing. For speaker-turn quality evidence, run this while playing a controlled multi-speaker phrase near the device microphone.",
  "validate": {
    "workflow": {
      "entry": "live-screen-smoke",
      "nodes": {
        "live-screen-smoke": {
          "action": "call",
          "ref": "moonshine-live-screen-ready",
          "next": "assert-route"
        },
        "assert-route": {
          "action": "eval_ref",
          "ref": "moonshine-live-state",
          "assert": {
            "operator": "eq",
            "field": "route",
            "value": "/moonshine-live"
          },
          "next": "press-prepare"
        },
        "press-prepare": {
          "action": "press",
          "test_id": "moonshine-live-prepare-models",
          "next": "wait-model-downloaded"
        },
        "wait-model-downloaded": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "operator": "eq",
            "field": "liveModelDownloaded",
            "value": true
          },
          "fail_when": {
            "operator": "not_null",
            "field": "error"
          },
          "timeout_ms": 600000,
          "poll_ms": 2000,
          "next": "press-start"
        },
        "press-start": {
          "action": "press",
          "test_id": "moonshine-live-start",
          "next": "wait-recording"
        },
        "wait-recording": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "all": [
              {
                "operator": "eq",
                "field": "isRecording",
                "value": true
              },
              {
                "operator": "eq",
                "field": "sherpaReady",
                "value": true
              }
            ]
          },
          "fail_when": {
            "operator": "not_null",
            "field": "error"
          },
          "timeout_ms": 120000,
          "poll_ms": 1000,
          "next": "wait-chunk-fanout"
        },
        "wait-chunk-fanout": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "all": [
              {
                "operator": "gte",
                "field": "moonshineStats.chunks",
                "value": 3
              },
              {
                "operator": "gte",
                "field": "sherpaStats.chunks",
                "value": 3
              }
            ]
          },
          "fail_when": {
            "operator": "not_null",
            "field": "error"
          },
          "timeout_ms": 60000,
          "poll_ms": 1000,
          "next": "wait-live-transcript"
        },
        "wait-live-transcript": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "any": [
              {
                "operator": "gte",
                "field": "liveInterimLineCount",
                "value": 1
              },
              {
                "operator": "gte",
                "field": "liveCommittedLineCount",
                "value": 1
              }
            ]
          },
          "fail_when": {
            "operator": "not_null",
            "field": "error"
          },
          "timeout_ms": 180000,
          "poll_ms": 1000,
          "next": "wait-sherpa-speech-event"
        },
        "wait-sherpa-speech-event": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "any": [
              {
                "operator": "gte",
                "field": "speakerEventCounts.speech_start",
                "value": 1
              },
              {
                "operator": "gte",
                "field": "speakerEventCounts.turn_final",
                "value": 1
              },
              {
                "operator": "gte",
                "field": "sherpaTurnCount",
                "value": 1
              }
            ]
          },
          "fail_when": {
            "operator": "not_null",
            "field": "error"
          },
          "timeout_ms": 180000,
          "poll_ms": 1000,
          "next": "press-stop"
        },
        "press-stop": {
          "action": "press",
          "test_id": "moonshine-live-stop",
          "next": "wait-speaker-turn-final"
        },
        "wait-speaker-turn-final": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "any": [
              {
                "operator": "gte",
                "field": "sherpaFinalTurnCount",
                "value": 1
              },
              {
                "operator": "gte",
                "field": "sherpaTurnCount",
                "value": 1
              }
            ]
          },
          "fail_when": {
            "operator": "not_null",
            "field": "error"
          },
          "timeout_ms": 120000,
          "poll_ms": 1000,
          "next": "wait-attributed-transcript"
        },
        "wait-attributed-transcript": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "any": [
              {
                "operator": "gte",
                "field": "attributedInterimLineCount",
                "value": 1
              },
              {
                "operator": "gte",
                "field": "attributedCommittedLineCount",
                "value": 1
              }
            ]
          },
          "fail_when": {
            "operator": "not_null",
            "field": "error"
          },
          "timeout_ms": 120000,
          "poll_ms": 1000,
          "next": "wait-stopped"
        },
        "wait-stopped": {
          "action": "wait_for",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || null)",
          "assert": {
            "operator": "eq",
            "field": "isRecording",
            "value": false
          },
          "timeout_ms": 60000,
          "poll_ms": 1000,
          "next": "done"
        },
        "done": {
          "action": "end",
          "status": "pass"
        }
      }
    }
  }
}
