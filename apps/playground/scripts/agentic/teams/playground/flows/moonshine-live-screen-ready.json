{
  "title": "Playground Moonshine + Sherpa live screen smoke validation",
  "validate": {
    "workflow": {
      "entry": "nav-moonshine-live",
      "pre_conditions": [
        "playground.agentic_ready"
      ],
      "nodes": {
        "nav-moonshine-live": {
          "action": "navigate",
          "target": "/moonshine-live",
          "next": "wait-live-route"
        },
        "wait-live-route": {
          "action": "wait_for",
          "route": "/moonshine-live",
          "next": "wait-prepare-button"
        },
        "wait-prepare-button": {
          "action": "wait_for",
          "test_id": "moonshine-live-prepare-models",
          "next": "wait-start-button"
        },
        "wait-start-button": {
          "action": "wait_for",
          "test_id": "moonshine-live-start",
          "next": "wait-metrics"
        },
        "wait-metrics": {
          "action": "wait_for",
          "test_id": "moonshine-sherpa-metrics",
          "next": "done"
        },
        "done": {
          "action": "end",
          "status": "pass"
        }
      }
    }
  }
}
