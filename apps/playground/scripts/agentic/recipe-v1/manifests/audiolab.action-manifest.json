{
    "runner_protocol_version": 1,
    "action_registry_version": 1,
    "supported_official_actions": [
        "wait",
        "end",
        "ui.navigate",
        "ui.press",
        "ui.set_input",
        "ui.scroll",
        "ui.screenshot",
        "app.status",
        "app.hud",
        "cdp.target"
    ],
    "action_metadata": {
        "ui.navigate": {
            "description": "Navigate by Expo Router path through the existing playground CDP bridge.",
            "schema": {
                "type": "object",
                "required": ["path"],
                "properties": {
                    "path": {
                        "type": "string"
                    }
                }
            },
            "examples": [
                {
                    "description": "Open the Record tab.",
                    "node": {
                        "action": "ui.navigate",
                        "intent": "Open the Record tab.",
                        "path": "/(tabs)/record",
                        "next": "next"
                    }
                }
            ]
        },
        "audiolab.native.extract_preview": {
            "description": "Run the app bridge extractPreview probe against the bundled sample file and poll getLastResult().",
            "schema": {
                "type": "object",
                "properties": {
                    "timeout_ms": {
                        "type": "number"
                    }
                }
            },
            "examples": [
                {
                    "description": "Run the native preview extractor and assert success.",
                    "node": {
                        "action": "audiolab.native.extract_preview",
                        "intent": "Run extractPreview and wait for success.",
                        "timeout_ms": 30000,
                        "assert": {
                            "path": "status",
                            "operator": "eq",
                            "value": "success"
                        },
                        "next": "proof"
                    }
                }
            ]
        },
        "audiolab.audio.state": {
            "description": "Read current playground audio recorder state through the CDP bridge.",
            "schema": {
                "type": "object"
            },
            "examples": [
                {
                    "description": "Read recorder state before proof steps.",
                    "node": {
                        "action": "audiolab.audio.state",
                        "intent": "Read recorder state.",
                        "next": "next"
                    }
                }
            ]
        },
        "app.hud": {
            "description": "Display the current Recipe v1 intent through the dev-only Farmslot Expo Recipe HUD.",
            "schema": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "intent": {
                        "type": "string"
                    },
                    "detail": {
                        "type": "string"
                    }
                }
            },
            "examples": [
                {
                    "description": "Show the current recipe intent.",
                    "node": {
                        "action": "app.hud",
                        "intent": "Show the current recipe step in the AudioLab HUD.",
                        "status": "running",
                        "next": "next"
                    }
                }
            ]
        }
    },
    "custom_actions": [
        {
            "name": "audiolab.audio.state",
            "owner": "audiolab.audio",
            "description": "Read current playground audio recorder state through the CDP bridge.",
            "schema": {
                "type": "object"
            },
            "examples": [
                {
                    "description": "Read current playground audio recorder state through the CDP bridge.",
                    "node": {
                        "action": "audiolab.audio.state",
                        "intent": "Read recorder state.",
                        "next": "next"
                    }
                }
            ]
        },
        {
            "name": "audiolab.native.extract_preview",
            "owner": "audiolab.native",
            "description": "Run extractPreview against the bundled sample audio and poll the async bridge result.",
            "schema": {
                "type": "object",
                "properties": {
                    "timeout_ms": {
                        "type": "number"
                    }
                }
            },
            "examples": [
                {
                    "description": "Run extractPreview against the bundled sample audio and poll the async bridge result.",
                    "node": {
                        "action": "audiolab.native.extract_preview",
                        "intent": "Run extractPreview and wait for success.",
                        "timeout_ms": 30000,
                        "next": "next"
                    }
                }
            ]
        },
        {
            "name": "audiolab.native.extract_audio_data",
            "owner": "audiolab.native",
            "description": "Run extractAudioData against the bundled sample audio and poll the async bridge result.",
            "schema": {
                "type": "object",
                "properties": {
                    "timeout_ms": {
                        "type": "number"
                    }
                }
            },
            "examples": [
                {
                    "description": "Run extractAudioData against the bundled sample audio and poll the async bridge result.",
                    "node": {
                        "action": "audiolab.native.extract_audio_data",
                        "intent": "Run extractAudioData and wait for success.",
                        "timeout_ms": 30000,
                        "next": "next"
                    }
                }
            ]
        },
        {
            "name": "audiolab.native.trim_audio",
            "owner": "audiolab.native",
            "description": "Run trimAudio against the bundled sample audio and poll the async bridge result.",
            "schema": {
                "type": "object",
                "properties": {
                    "timeout_ms": {
                        "type": "number"
                    }
                }
            },
            "examples": [
                {
                    "description": "Run trimAudio against the bundled sample audio and poll the async bridge result.",
                    "node": {
                        "action": "audiolab.native.trim_audio",
                        "intent": "Run trimAudio and wait for success.",
                        "timeout_ms": 45000,
                        "next": "next"
                    }
                }
            ]
        },
        {
            "name": "audiolab.asr.last_result",
            "owner": "audiolab.asr",
            "description": "Read the last async AudioLab bridge result, typically from ASR or native probes.",
            "schema": {
                "type": "object"
            },
            "examples": [
                {
                    "description": "Read the last async AudioLab bridge result, typically from ASR or native probes.",
                    "node": {
                        "action": "audiolab.asr.last_result",
                        "intent": "Read the last async bridge result.",
                        "next": "next"
                    }
                }
            ]
        }
    ]
}
