{
  "schema_version": 1,
  "title": "AudioLab Recipe v1 navigation smoke",
  "description": "Proves the AudioLab playground bridge can inspect the runtime, navigate core screens, and capture screenshot evidence.",
  "proofTargets": [
    { "id": "runtime", "claim": "A Recipe v1 runner can connect to an AudioLab playground dev runtime." },
    { "id": "navigation", "claim": "The runner can navigate visible playground screens and capture proof." }
  ],
  "validate": {
    "workflow": {
      "entry": "target",
      "nodes": {
        "target": { "action": "cdp.target", "description": "Discover an AudioLab agentic CDP target.", "next": "status", "proofTarget": "runtime" },
        "status": { "action": "app.status", "description": "Read recorder state before navigation.", "next": "record", "proofTarget": "runtime" },
        "record": { "action": "ui.navigate", "path": "/(tabs)/record", "description": "Open the Record tab.", "next": "import" },
        "import": { "action": "ui.navigate", "path": "/(tabs)/import", "description": "Open the Import tab.", "next": "files" },
        "files": { "action": "ui.navigate", "path": "/(tabs)/files", "description": "Open the Files tab.", "next": "more" },
        "more": { "action": "ui.navigate", "path": "/(tabs)/more", "description": "Open the More tab.", "next": "proof" },
        "proof": { "action": "ui.screenshot", "label": "audiolab-navigation-v1", "description": "Capture final navigation proof.", "next": "done", "proofTarget": "navigation", "record": "proof_window" },
        "done": { "action": "end", "status": "pass" }
      }
    }
  }
}
