{
  "title": "Sherpa Voice diarization UI validation with 5-minute WAV fixture",
  "description": "Runs the existing Speaker Diarization page against a device-local 5-minute 16 kHz mono WAV fixture copied to the app sandbox. Requires pyannote-segmentation-3-0 and speaker-id-en-voxceleb to be downloaded, and the fixture at files/validation/perps_controller_refactor_5m_16k_mono.wav.",
  "validate": {
    "workflow": {
      "entry": "nav-diarization",
      "pre_conditions": ["sherpa.agentic_ready"],
      "nodes": {
        "nav-diarization": {
          "action": "navigate",
          "target": "/features/diarization",
          "next": "wait-init"
        },
        "wait-init": {
          "action": "wait_for",
          "test_id": "diar-init-btn",
          "timeout_ms": 30000,
          "next": "press-init"
        },
        "press-init": {
          "action": "press",
          "test_id": "diar-init-btn",
          "next": "wait-ready"
        },
        "wait-ready": {
          "action": "wait_for",
          "test_id": "diar-release-btn",
          "timeout_ms": 120000,
          "fail_when": { "operator": "not_null", "field": "pageState.error" },
          "next": "set-custom-path"
        },
        "set-custom-path": {
          "action": "set_input",
          "test_id": "diar-custom-audio-input",
          "value": "file:///data/user/0/net.siteed.sherpavoice.development/files/validation/perps_controller_refactor_5m_16k_mono.wav",
          "next": "use-custom-path"
        },
        "use-custom-path": {
          "action": "press",
          "test_id": "diar-use-custom-audio-btn",
          "next": "wait-run-button"
        },
        "wait-run-button": {
          "action": "wait_for",
          "test_id": "diar-run-btn",
          "timeout_ms": 30000,
          "next": "press-run"
        },
        "press-run": {
          "action": "press",
          "test_id": "diar-run-btn",
          "next": "wait-result"
        },
        "wait-result": {
          "action": "wait_for",
          "description": "wait for non-empty 5-minute diarization result",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || {})",
          "assert": { "operator": "gt", "field": "segmentsCount", "value": 0 },
          "fail_when": { "operator": "not_null", "field": "error" },
          "timeout_ms": 300000,
          "poll_ms": 1000,
          "next": "assert-speaker-count"
        },
        "assert-speaker-count": {
          "action": "eval_sync",
          "description": "capture final 5-minute diarization page state",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getPageState?.() || {})",
          "assert": { "operator": "gte", "field": "numSpeakers", "value": 1 },
          "next": "done"
        },
        "done": { "action": "end", "status": "pass" }
      }
    }
  }
}
