{
  "title": "Sherpa Voice live transcription + speaker-turn replay validation",
  "description": "Replays a device-local 16 kHz mono WAV as live chunks through streaming ASR, VAD, and Speaker ID. Validates the combined LiveAttributedTranscriptionSession event contract and checks whether replay processing keeps up with realtime. Requires streaming-zipformer-en-20m-mobile, silero-vad-v5, and speaker-id-en-voxceleb to be downloaded.",
  "validate": {
    "workflow": {
      "entry": "nav-diarization",
      "pre_conditions": [
        "sherpa.agentic_ready"
      ],
      "nodes": {
        "nav-diarization": {
          "action": "navigate",
          "target": "/features/diarization",
          "next": "run-live-replay"
        },
        "run-live-replay": {
          "action": "eval_sync",
          "description": "Fire live replay through ASR + VAD + Speaker ID on first 60s of the validation WAV.",
          "expression": "JSON.stringify((function(){var A=globalThis.__AGENTIC__;if(!A||!A.testLiveTranscriptionDiarizationReplay||!A.getLastResult){return {status:'error',error:'agentic bridge missing testLiveTranscriptionDiarizationReplay/getLastResult'};}return A.testLiveTranscriptionDiarizationReplay('file:///data/user/0/net.siteed.sherpavoice.development/files/validation/perps_controller_refactor_5m_16k_mono.wav',{maxDurationMs:60000,chunkDurationMs:100,asrModelId:'streaming-zipformer-en-20m-mobile',vadModelId:'silero-vad-v5',speakerIdModelId:'speaker-id-en-voxceleb'});})())",
          "assert": {
            "operator": "eq",
            "field": "status",
            "value": "pending"
          },
          "next": "wait-live-result"
        },
        "assert-keeps-up": {
          "action": "eval_sync",
          "description": "Assert replay processing kept up with realtime on device.",
          "expression": "JSON.stringify(globalThis.__AGENTIC__.getLastResult())",
          "assert": {
            "operator": "eq",
            "field": "result.keepsUpWithReplay",
            "value": true
          },
          "next": "assert-transcript-events"
        },
        "assert-transcript-events": {
          "action": "eval_sync",
          "description": "Assert live replay produced final transcript segments and speaker-turn events.",
          "expression": "JSON.stringify(globalThis.__AGENTIC__.getLastResult())",
          "assert": {
            "operator": "gt",
            "field": "result.summary.finalSegmentCount",
            "value": 0
          },
          "next": "assert-speaker-events"
        },
        "assert-speaker-events": {
          "action": "eval_sync",
          "description": "Assert at least one turn reached finalization.",
          "expression": "JSON.stringify(globalThis.__AGENTIC__.getLastResult())",
          "assert": {
            "operator": "gt",
            "field": "result.eventCounts.turn_finalized",
            "value": 0
          },
          "next": "done"
        },
        "done": {
          "action": "end",
          "status": "pass"
        },
        "wait-live-result": {
          "action": "wait_for",
          "description": "Poll fire-and-store live replay result.",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getLastResult?.() || {})",
          "assert": {
            "operator": "eq",
            "field": "status",
            "value": "success"
          },
          "fail_when": {
            "operator": "eq",
            "field": "status",
            "value": "error"
          },
          "timeout_ms": 300000,
          "poll_ms": 1000,
          "next": "assert-keeps-up"
        }
      }
    }
  }
}
