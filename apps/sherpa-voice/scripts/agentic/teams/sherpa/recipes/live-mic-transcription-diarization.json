{
  "title": "Sherpa Voice live microphone transcription + speaker-turn keep-up validation",
  "description": "Records short live microphone audio with streamFormat:'float32' and feeds chunks into streaming ASR, VAD, and Speaker ID. This validates the real mic path and processing backpressure on device. It does not require speech in the room; transcript/speaker events are opportunistic.",
  "validate": {
    "workflow": {
      "entry": "nav-diarization",
      "pre_conditions": ["sherpa.agentic_ready"],
      "nodes": {
        "nav-diarization": {
          "action": "navigate",
          "target": "/features/diarization",
          "next": "run-live-mic"
        },
        "run-live-mic": {
          "action": "eval_sync",
          "description": "Fire 10s mic recording through ASR + VAD + Speaker ID.",
          "expression": "JSON.stringify((function(){var A=globalThis.__AGENTIC__;if(!A||!A.testLiveMicTranscriptionDiarization||!A.getLastResult){return {status:'error',error:'agentic bridge missing testLiveMicTranscriptionDiarization/getLastResult'};}return A.testLiveMicTranscriptionDiarization({durationMs:10000,chunkDurationMs:100,asrModelId:'streaming-zipformer-en-20m-mobile',vadModelId:'silero-vad-v5',speakerIdModelId:'speaker-id-en-voxceleb'});})())",
          "assert": { "operator": "eq", "field": "status", "value": "pending" },
          "next": "wait-live-mic-result"
        },
        "wait-live-mic-result": {
          "action": "wait_for",
          "description": "Poll fire-and-store mic result.",
          "expression": "JSON.stringify(globalThis.__AGENTIC__?.getLastResult?.() || {})",
          "assert": { "operator": "eq", "field": "status", "value": "success" },
          "fail_when": { "operator": "eq", "field": "status", "value": "error" },
          "timeout_ms": 120000,
          "poll_ms": 1000,
          "next": "assert-keeps-up"
        },
        "assert-keeps-up": {
          "action": "eval_sync",
          "description": "Assert mic processing kept up without backpressure.",
          "expression": "JSON.stringify(globalThis.__AGENTIC__.getLastResult())",
          "assert": { "operator": "eq", "field": "result.keepsUpWithLiveAudio", "value": true },
          "next": "assert-chunks"
        },
        "assert-chunks": {
          "action": "eval_sync",
          "description": "Assert mic chunks were received and processed.",
          "expression": "JSON.stringify(globalThis.__AGENTIC__.getLastResult())",
          "assert": { "operator": "gt", "field": "result.stats.chunks", "value": 0 },
          "next": "done"
        },
        "done": { "action": "end", "status": "pass" }
      }
    }
  }
}
